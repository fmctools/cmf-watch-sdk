#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
out=$root/fw/target/thumbv7em-none-eabi/release
packages=(-p wp2-stub -p wp3-stub)
loader=0
if [ -f "$root/fw/wp2-loader/Cargo.toml" ]; then
    packages+=(-p wp2-loader)
    loader=1
fi
(cd "$root/fw" && cargo build --release "${packages[@]}")
mkdir -p "$root/target"
cd "$root"
llvm-objcopy -O binary "$out/wp2-stub" target/wp2-stub.bin
llvm-objcopy -O binary "$out/wp3-stub" target/wp3-stub.bin
if [ "$loader" = 1 ]; then
    llvm-objcopy -O binary --set-section-flags .data=alloc,load,contents "$out/wp2-loader" target/loader.bin
    rm -f target/loader.wp2app
    uv run --locked wp2apps pack target/loader.bin --elf "$out/wp2-loader" --kind loader --name loader \
        --version "${WP2_LOADER_VERSION:-1}" --output target/loader.wp2app
    # the Watch 3 Pro loader: the same crate with its own feature, in its own invocation and target dir (a feature of
    # the loader only, so the stubs above never see it)
    (cd "$root/fw" && cargo build --release -p wp2-loader --features wp3 --target-dir target/wp3)
    out3=$root/fw/target/wp3/thumbv7em-none-eabi/release
    llvm-objcopy -O binary --set-section-flags .data=alloc,load,contents "$out3/wp2-loader" target/loader-wp3.bin
    rm -f target/loader-wp3.wp2app
    uv run --locked wp2apps pack target/loader-wp3.bin --elf "$out3/wp2-loader" --kind loader --model wp3 \
        --name loader --version "${WP2_LOADER_VERSION:-1}" --output target/loader-wp3.wp2app
fi
rm -f target/app-wp2.bin
uv run --locked wp2apps firmware --stub target/wp2-stub.bin --output target/app-wp2.bin
echo "$root/target/app-wp2.bin"
rm -f target/app-wp3.bin
# cmf-watch-utils' pinned commit (the release CI) has no 3 Pro image: only that model is left out then
if [ -f "${CMF_WATCH_UTILS:-$root/../cmf-watch-utils}/dumps/binaries/firmware/JX402_w3pro_V1.0.1.77.bin" ]; then
    uv run --locked wp2apps firmware --model wp3 --stub target/wp3-stub.bin --output target/app-wp3.bin
    echo "$root/target/app-wp3.bin"
else
    echo "skipped app-wp3.bin: no JX402_w3pro_V1.0.1.77.bin in cmf-watch-utils" >&2
fi

#!/usr/bin/env python3
"""Publish the patched firmware or the App Loader to FMC (.github/workflows/fmc-release.yml).

  publish-fmc draft firmware target/fw-wp2.bin   checks, uploads a new unpublished record, prints its id
  publish-fmc draft loader target/loader.wp2app
  publish-fmc promote DRAFT_ID SHA256 OUT_DIR    the draft's image onto the live record, the draft deleted;
                                                 leaves the image and the description
                                                 (<kind>-notes.md) in OUT_DIR, prints the git tag

Env: FMC_PUBLISHER_EMAIL, FMC_PUBLISHER_PASSWORD (a `publishers` account), FMC_URL (default prod),
FMC_DESCRIPTION (markdown; empty keeps the live record's), GITHUB_SHA.
"""
import datetime
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import urllib.error
import urllib.request
import uuid
import zlib

ROOT = Path(__file__).resolve().parents[1]
URL = os.environ.get("FMC_URL", "https://fmc.freethinkel.dev").rstrip("/")
LIVE = {"patched": "kqbnulphohzw2wb", "loader": "bfe60t13x4bgbgc"}  # the records the store shows
KIND = {"firmware": "patched", "loader": "loader"}
SOURCE = {"patched": "https://github.com/cmf-tech-community/cmf-watch-sdk",
          "loader": "https://github.com/cmf-tech-community/cmf-watch-sdk/tree/main/fw/wp2-loader"}
BOARD = "jx402_01_3089c"  # Watch Pro 2; fmc_frontend ota-image.ts reads it at 0x60
RECORDS = "/api/collections/firmwares/records"


def call(method, path, token="", fields=None, image=None, body=None):
    # Cloudflare in front of FMC answers 403 (error 1010) to the default Python-urllib agent
    headers, data = {"Authorization": token, "User-Agent": "cmf-watch-sdk-fmc-release"}, None
    if body is not None:
        data, headers["Content-Type"] = json.dumps(body).encode(), "application/json"
    elif fields is not None:
        b = uuid.uuid4().hex
        parts = [f'--{b}\r\nContent-Disposition: form-data; name="{k}"\r\n\r\n{v}\r\n'.encode() for k, v in fields.items()]
        if image:
            parts.append(f'--{b}\r\nContent-Disposition: form-data; name="image"; filename="{image[0]}"\r\n'
                         f'Content-Type: application/octet-stream\r\n\r\n'.encode() + image[1] + b"\r\n")
        data, headers["Content-Type"] = b"".join(parts) + f"--{b}--\r\n".encode(), f"multipart/form-data; boundary={b}"
    try:
        with urllib.request.urlopen(urllib.request.Request(URL + path, data, headers, method=method), timeout=900) as r:
            raw = r.read()
    except urllib.error.HTTPError as e:
        sys.exit(f"{method} {path}: {e.code} {e.read().decode(errors='replace')[:800]}")
    return raw if path.startswith("/api/files/") else json.loads(raw or b"null")


def login():
    return call("POST", "/api/collections/publishers/auth-with-password", body={
        "identity": os.environ["FMC_PUBLISHER_EMAIL"], "password": os.environ["FMC_PUBLISHER_PASSWORD"]})["token"]


def file_of(rec, token):
    return call("GET", f"/api/files/{rec['collectionId']}/{rec['id']}/{rec['image']}", token)


def need(ok, why):
    if not ok:
        sys.exit(f"refused: {why}")


def stub_version():
    return int(re.search(r"STUB_VERSION: u32 = (\d+);", (ROOT / "fw/wp2-core/src/layout.rs").read_text())[1])


def draft(what, path):
    kind, data, token = KIND[what], Path(path).read_bytes(), login()
    live = call("GET", f"{RECORDS}/{LIVE[kind]}", token)
    sha7 = os.environ["GITHUB_SHA"][:7]
    if kind == "patched":
        stub = stub_version()
        need(stub > live["stub"], f"STUB_VERSION {stub} is not above the live record's stub {live['stub']}")
        board = data[0x60:0x60 + 28].split(b"\0")[0].decode(errors="replace")
        need(board == BOARD, f"the image is for board {board!r}, not {BOARD}")
        verify = subprocess.run(["uv", "run", "--locked", "fwkit", "verify", path], cwd=ROOT, capture_output=True, text=True)
        need(verify.stdout.strip().endswith("ok"), f"fwkit verify: {verify.stdout.strip()} {verify.stderr.strip()}")
        prefix, n = re.fullmatch(r"(.*?)(\d+)", live["version"]).groups()
        version = f"{prefix}{int(n) + 1}"  # 1.0.0.73-wp2.7 -> 1.0.0.73-wp2.8
    else:
        stub = 0
        need(data[:4] == b"WP2A" and data[6] == 1, "not a loader package")
        crc = int.from_bytes(data[0x30:0x34], "little")
        need(crc == zlib.crc32(data[0x40:]), "package body CRC")  # image + relocations
        need(crc != int.from_bytes(file_of(live, token)[0x30:0x34], "little"), "the live App Loader is this same build")
        version = f"{datetime.date.today()}-{sha7}"
    rec = call("POST", RECORDS, token, {
        "name": f"{live['name']} (draft {sha7})", "summary": live["summary"],
        "description": os.environ.get("FMC_DESCRIPTION") or live["description"],
        "version": version, "device": live["device"], "author": live["author"], "source": SOURCE[kind],
        "kind": kind, "base": live["base"], "stub": stub, "published": "false", "tested": "emulator",
    }, (Path(path).name, data))
    print(f"draft {rec['id']}: {kind} {version}, sha256 {hashlib.sha256(data).hexdigest()}", file=sys.stderr)
    print(rec["id"])


def promote(draft_id, sha256, out):
    token = login()
    rec = call("GET", f"{RECORDS}/{draft_id}", token)
    need(not rec["published"] and rec["kind"] in LIVE, f"{draft_id} is not a draft")
    data = file_of(rec, token)
    need(hashlib.sha256(data).hexdigest() == sha256, "the draft's image is not the one the draft job uploaded")
    live = call("GET", f"{RECORDS}/{LIVE[rec['kind']]}", token)
    if rec["kind"] == "patched":
        need(rec["stub"] > live["stub"], f"draft stub {rec['stub']} is not above the live stub {live['stub']}")
    name = "loader.wp2app" if rec["kind"] == "loader" else f"app_loader_stub{rec['stub']}.bin"
    call("PATCH", f"{RECORDS}/{live['id']}", token, {
        "version": rec["version"], "stub": rec["stub"], "description": rec["description"],
        "tested": "hardware", "source": rec["source"]}, (name, data))
    call("DELETE", f"{RECORDS}/{draft_id}", token)
    Path(out).mkdir(parents=True, exist_ok=True)
    (Path(out) / name).write_bytes(data)
    (Path(out) / f"{rec['kind']}-notes.md").write_text(rec["description"])  # the GitHub release's text
    print(f"stub-v{rec['stub']}" if rec["kind"] == "patched" else f"loader-{rec['version']}")


if __name__ == "__main__":
    {"draft": draft, "promote": promote}[sys.argv[1]](*sys.argv[2:])
